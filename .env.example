# Runtime variables for the frontend SERVICE (read by Caddy, not by Vite/React).
# Set them as Railway service Variables; nothing here is baked into the bundle.

# Where Caddy forwards /api, /v1 and /health. On Railway use the backend
# service's private-network address — the hostname is the SERVICE NAME:
BACKEND_URL=http://ohshi-back.railway.internal:8000
# Railway injects PORT automatically — only set it for local docker runs.
# PORT=8080

# Local development doesn't use this file at all: `npm run dev` proxies
# /api, /v1 and /health to http://127.0.0.1:8000 (see vite.config.ts).

# --- Clerk (optional) --------------------------------------------------------
# The ONE variable here that is baked into the bundle, so changing it needs a
# rebuild, not just a restart. Unset = the built-in email + password sign-in.
# It must match OHSHI_CLERK_PUBLISHABLE_KEY on the backend. See
# ../backend/docs/CLERK.md for the dashboard and DNS steps.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_…
